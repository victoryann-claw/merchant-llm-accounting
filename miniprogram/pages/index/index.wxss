/* 聊天容器 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

/* 欢迎提示 */
.welcome-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  color: #999;
  font-size: 28rpx;
}

.welcome-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #bbb;
}

/* 加载中 */
.loading-tip {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* 消息项 */
.message-item {
  display: flex;
  margin-bottom: 40rpx;
}

.message-item.user {
  justify-content: flex-end;
}

.message-item.ai {
  justify-content: flex-start;
}

/* 消息气泡 */
.message-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  word-break: break-word;
}

.message-bubble.user {
  background: #1890ff;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.message-bubble.ai {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* 文字消息 */
.bubble-text {
  font-size: 28rpx;
  line-height: 1.5;
}

/* 图片消息 */
.msg-image {
  max-width: 300rpx;
  border-radius: 8rpx;
}

/* 语音消息 */
.voice-msg {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 120rpx;
}

.voice-icon {
  font-size: 32rpx;
}

.voice-text {
  font-size: 26rpx;
}

/* AI确认消息头部 */
.ai-header {
  font-size: 22rpx;
  color: #52c41a;
  margin-bottom: 12rpx;
  font-weight: bold;
}

/* 确认内容 */
.confirm-content {
  padding: 8rpx 0;
}

.confirm-type {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.confirm-info {
  font-size: 24rpx;
  color: #666;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.confirm-items {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.confirm-suggestions {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.suggestion-tag {
  background: #fff7e6;
  color: #fa8c16;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

/* 确认按钮 */
.confirm-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn-confirm {
  background: #1890ff;
  color: #fff;
  font-size: 24rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
}

/* 输入区域 */
.input-area {
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
  padding: 16rpx 20rpx;
}

/* 功能按钮栏 */
.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 30rpx;
  color: #666;
  font-size: 22rpx;
}

.action-item.active {
  color: #1890ff;
}

.action-emoji {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

/* 文字输入框 */
.text-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.text-input {
  flex: 1;
  background: #f5f5f5;
  padding: 16rpx 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #e5e5e5;
  color: #999;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.send-btn.active {
  background: #1890ff;
  color: #fff;
}

/* 语音录入 */
.voice-input-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.voice-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.voice-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #1890ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.voice-btn.recording {
  background: #ff4d4f;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.voice-btn-icon {
  font-size: 60rpx;
}

/* 图片选择 */
.image-picker-area {
  padding: 30rpx;
}

.pick-btn {
  background: #f5f5f5;
  color: #333;
  font-size: 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
