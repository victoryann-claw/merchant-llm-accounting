<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-input" placeholder="自然语言查询，如：老王的账" bindconfirm="onSearch"/>
  </view>

  <!-- 筛选 -->
  <view class="filter-bar">
    <picker mode="date" value="{{dateRange[0]}}" bindchange="onDateChange">
      <view class="filter-item">
        <text>{{dateRange[0]}} ~ {{dateRange[1]}}</text>
        <image src="/assets/icons/calendar.png" class="filter-icon"/>
      </view>
    </picker>
    <picker mode="selector" range="{{typeOptions}}" bindchange="onTypeChange">
      <view class="filter-item">
        <text>{{typeOptions[typeIndex] || '全部类型'}}</text>
        <image src="/assets/icons/filter.png" class="filter-icon"/>
      </view>
    </picker>
  </view>

  <!-- 记录列表 -->
  <view class="records-list">
    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view wx:elif="{{records.length === 0}}" class="empty-tip">暂无记录</view>
    <view wx:else>
      <view wx:for="{{records}}" wx:key="id" class="record-card">
        <view class="record-header">
          <view class="record-type-tag {{item.record_type}}">
            {{item.record_type === 'delivery' ? '送货' : item.record_type === 'purchase' ? '进货' : '付款'}}
          </view>
          <text class="record-date">{{item.occurred_at}}</text>
        </view>
        
        <view class="record-body">
          <view class="record-counterparty">{{item.counterparty || '无对方'}}</view>
          <view class="record-items" wx:if="{{item.metadata.items}}">
            <text wx:for="{{item.metadata.items}}" wx:for-item="goods" wx:key="name">
              {{goods.name}} {{goods.qty}}{{goods.unit}} × {{goods.price}}元
              {{index < item.metadata.items.length - 1 ? '；' : ''}}
            </text>
          </view>
        </view>

        <view class="record-footer">
          <view class="record-amount {{item.record_type}}">
            {{item.record_type === 'purchase' ? '-' : '+'}}¥{{item.total_amount || 0}}
          </view>
          <view class="record-actions">
            <text class="action-text" bindtap="onDelete" data-id="{{item.id}}">删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
