.search-bar {
  padding: 20rpx 30rpx;
  background: #fff;
}

.search-input {
  background: #f5f5f5;
  padding: 20rpx 30rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
}

.filter-bar {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.filter-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
}

.records-list {
  padding: 30rpx;
}

.record-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.record-type-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.record-type-tag.delivery {
  background: #e6f7ff;
  color: #1890ff;
}

.record-type-tag.purchase {
  background: #fff7e6;
  color: #fa8c16;
}

.record-type-tag.payment {
  background: #f6ffed;
  color: #52c41a;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-body {
  margin-bottom: 20rpx;
}

.record-counterparty {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.record-items {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.record-amount {
  font-size: 36rpx;
  font-weight: bold;
}

.record-amount.delivery {
  color: #52c41a;
}

.record-amount.purchase {
  color: #fa8c16;
}

.record-amount.payment {
  color: #1890ff;
}

.action-text {
  color: #ff4d4f;
  font-size: 26rpx;
}

.loading-tip,
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
