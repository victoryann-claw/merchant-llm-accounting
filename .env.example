# 商户记账系统 - 环境变量配置

# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=merchant_accounting

# API服务
API_PORT=8080

# 通义千问 LLM
QWEN_API_KEY=your_qwen_api_key
QWEN_MODEL=qwen-turbo  # 可选: qwen-turbo, qwen-plus, qwen-max

# 通义千问 VL (图片识别)
QWEN_VL_API_KEY=your_qwen_vl_api_key

# 腾讯云 ASR (语音识别)
TENCENT_ASR_SECRET_ID=your_tencent_secret_id
TENCENT_ASR_SECRET_KEY=your_tencent_secret_key

# 微信小程序
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
